# --- MySQL ---
MYSQL_DATABASE=ai_health_companion
MYSQL_USER=healthapp
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST_PORT=3307

# --- Spring Boot ---
DB_URL=jdbc:mysql://localhost:3307/ai_health_companion?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=healthapp
DB_PASSWORD=change-this-local-password
CORS_ALLOWED_ORIGINS=http://localhost:5173
AI_MODE=mock

# Used in Phase 2. Generate a long, unique secret before enabling JWT issuance.
JWT_SECRET=replace-with-a-256-bit-or-longer-secret

# Reserved for a production AI provider; never commit a real value.
AI_PROVIDER_BASE_URL=http://localhost:8000
AI_PROVIDER_API_KEY=

# Optional LLM API keys for real conversational generation (Gemini or OpenAI)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=
