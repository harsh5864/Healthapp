# --- PostgreSQL (Deployment & Docker Compose) ---
POSTGRES_DB=ai_health_companion
POSTGRES_USER=healthapp
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST_PORT=5432

# --- Spring Boot ---
# In cloud deployment (Render, Supabase, Neon, Railway), set DATABASE_URL or DB_URL:
DB_URL=jdbc:postgresql://localhost:5432/ai_health_companion
DB_USERNAME=healthapp
DB_PASSWORD=change-this-local-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AI_MODE=mock

# --- Docker host ports ---
AI_HOST_PORT=8001
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=3000

# Used in Phase 2. Generate a long, unique secret before enabling JWT issuance.
JWT_SECRET=replace-with-a-256-bit-or-longer-secret

# Reserved for a production AI provider; never commit a real value.
AI_PROVIDER_BASE_URL=http://localhost:8000
AI_PROVIDER_API_KEY=

# Optional LLM API keys for real conversational generation (OpenRouter, Gemini, or OpenAI)
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=
